# The notify service behind vhrd.tech's signup forms (vhrd_site README "Notify service"), a user unit of the web
# server's login user, installed by `just deploy-notify` (tpm ship) as ~/.config/systemd/user/vhrd-notify.service.
# Needs linger. nginx proxies /api/notify to it (deploy/nginx-notify.conf); it listens on loopback only.
# Signups: ~/vhrd_notify/signups.tsv (0600). Logs: `journalctl _SYSTEMD_USER_UNIT=vhrd-notify.service -f`.
[Unit]
Description=vhrd_notify: the Get notified signup endpoint for vhrd.tech
Wants=network-online.target
After=network-online.target
# ends in `failed` after a run of fast crashes instead of restarting forever unnoticed
StartLimitIntervalSec=10min
StartLimitBurst=6
# the unit ended in `failed`: tpm-recover brings the previous good release back, once
OnFailure=tpm-recover@%n.service

[Service]
ExecStart=%h/vhrd_notify/vhrd_notify serve --config %h/vhrd_notify/notify.toml
# the store and its lock file are for this user only
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
Restart=on-failure
RestartSec=30
RestartSteps=5
RestartMaxDelaySec=5min
# a broken settings file: one line in the journal, no restart until someone fixes it
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
