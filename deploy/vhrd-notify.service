# The notify service behind vhrd.tech's signup forms (AGENTS.md "Notify service" in this repo), a user unit of the
# vhrd-notify user on the web server, in ~/.config/systemd/user/vhrd-notify.service. Needs linger. Releases come from
# the Deploy workflow through vhrd-notify-activate.path. nginx proxies /api/notify to it (deploy/nginx-notify.conf);
# it listens on loopback only. Signups: ~/vhrd_notify/signups.tsv (0600).
# Logs: `journalctl _SYSTEMD_USER_UNIT=vhrd-notify.service -f`.
[Unit]
Description=vhrd_notify: the Get notified signup endpoint for vhrd.tech
# ends in `failed` after a run of fast crashes instead of restarting forever unnoticed
StartLimitIntervalSec=10min
StartLimitBurst=6

[Service]
ExecStart=%h/vhrd_notify/vhrd_notify serve --config %h/vhrd_notify/notify.toml
# the store and its lock file are for this user only
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
Restart=on-failure
RestartSec=30
RestartSteps=5
RestartMaxDelaySec=5min
# a broken settings file: one line in the journal, no restart until someone fixes it
RestartPreventExitStatus=78
# a restart by the activator must not wait the default 90 s for a stuck stop
TimeoutStopSec=10s

[Install]
WantedBy=default.target
